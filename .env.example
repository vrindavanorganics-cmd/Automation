# Copy this file to .env and fill in values. Never commit the real .env file.

# --- Cloud LLM (used for complex reasoning / planning; optional) ---
# ORBIT works offline for voice + computer control without these, but
# complex multi-step planning quality improves a lot with a cloud LLM.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- LLM provider selection ---
ORBIT_LLM_PROVIDER=anthropic
ORBIT_LLM_MODEL=claude-sonnet-5

# --- ASR (speech-to-text) ---
ORBIT_ASR_ENGINE=faster-whisper
ORBIT_ASR_MODEL_SIZE=small
ORBIT_ASR_DEVICE=cpu
ORBIT_ASR_LANGUAGE=auto

# --- Data / storage locations ---
ORBIT_DATA_DIR=./data

# --- Safety ---
# When true, sensitive actions (send email, delete files, etc.) always require
# explicit confirmation regardless of skill settings. Do not disable lightly.
ORBIT_REQUIRE_CONFIRMATION=true

# --- Force the simulated Windows controller even on Windows (useful for testing) ---
ORBIT_FORCE_SIMULATED=false

# --- Global hotkey for push-to-talk ---
ORBIT_HOTKEY=ctrl+shift+space
